# SHIBLI C2 production builder — Ubuntu 22.04 LTS x86-64 ABI baseline.
# Build context: this directory (deployment/ubuntu).
# Python application dependencies are installed at run time from the mounted source.
FROM ubuntu:22.04

ENV DEBIAN_FRONTEND=noninteractive \
    LANG=C.UTF-8 \
    LC_ALL=C.UTF-8 \
    PYTHONDONTWRITEBYTECODE=1

RUN apt-get update && apt-get install -y --no-install-recommends \
        python3 \
        python3-venv \
        python3-pip \
        python3-dev \
        python3-gi \
        python3-gi-cairo \
        build-essential \
        pkg-config \
        libsqlcipher-dev \
        sqlcipher \
        libffi-dev \
        libssl-dev \
        libcairo2-dev \
        libgirepository1.0-dev \
        ffmpeg \
        file \
        binutils \
        rsync \
        dpkg-dev \
        wget \
        ca-certificates \
        gir1.2-gtk-3.0 \
        gir1.2-webkit2-4.0 \
        gir1.2-glib-2.0 \
        libgtk-3-0 \
        libgdk-pixbuf-2.0-0 \
        libwebkit2gtk-4.0-37 \
        shared-mime-info \
    && rm -rf /var/lib/apt/lists/*

# Record the builder ABI once so the inner script can copy it into the manifest.
RUN printf '%s\n' \
        "BUILD_OS=Ubuntu 22.04 LTS" \
        "BUILD_ARCH=$(dpkg --print-architecture)" \
        "GLIBC=$({ ldd --version 2>&1 || true; } | head -n 1)" \
        "PYTHON=$(python3 --version)" \
        "FFMPEG=$({ ffmpeg -version 2>&1 || true; } | head -n 1)" \
        > /etc/shibli-build-baseline.txt \
    && cat /etc/shibli-build-baseline.txt

WORKDIR /work
CMD ["/bin/bash", "/src/deployment/ubuntu/build-inside-2204.sh"]
