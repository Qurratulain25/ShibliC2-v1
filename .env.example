# Keep localhost for desktop. Use 0.0.0.0 on Ubuntu edge servers for LAN access.
VMS_HOST=127.0.0.1
VMS_PORT=8080

# Set to 1 on headless Ubuntu / systemd deployments
SHIBLI_NO_BROWSER=0

# SHIBLI backend services (proxy from C2 UI)
SHIBLI_CORE_URL=http://127.0.0.1:3000
SHIBLI_CONTROLS_URL=http://127.0.0.1:8001
# Path to SHIBLI-controls (folder with server.py) — used by scripts/start-controls.sh
# Example: SHIBLI_CONTROLS_DIR=/opt/shiblic2/SHIBLI-controls
SHIBLI_CONTROLS_DIR=
SHIBLI_CONTROLS_PORT=8001
SHIBLI_VSS_URL=http://127.0.0.1:8000

# Optional service account for SHIBLI-Core API (when Core is running)
SHIBLI_CORE_SERVICE_USER=
SHIBLI_CORE_SERVICE_PASSWORD=

# development | production — production refuses insecure/missing JWT secrets
SHIBLI_ENV=development

# Required unique value when SHIBLI_ENV=production.
# Generate a long random value and store it only in the real .env.
SHIBLI_JWT_SECRET=
SHIBLI_API_TOKEN=

SHIBLI_DB_KEY=

# Optional first-run development seed only. Leave empty on client installs —
# the login screen creates the first administrator instead.
SHIBLI_DEFAULT_ADMIN_USER=
SHIBLI_DEFAULT_ADMIN_PASSWORD=

# Site-specific password recovery code. Leave empty to disable forgot-password.
SHIBLI_PASSWORD_RECOVERY_CODE=

# go2rtc WebRTC (optional — low-latency video)
GO2RTC_ENABLED=1
GO2RTC_API_URL=http://127.0.0.1:1984
GO2RTC_STREAM_DAY=day
GO2RTC_STREAM_THERMAL=thermal

# Storage warning when recordings partition free space below this (GB)
SHIBLI_STORAGE_WARN_GB=5

# Test PTZ/LRF/Illuminator without a live camera (1 = on). Off by default.
SHIBLI_HW_SIMULATE=0

# On hardware failure, return simulated success instead of ok:false (1 = on). Off by default.
# Production must leave this at 0 so failed PTZ/LRF/aux commands report errors.
SHIBLI_HW_SIMULATE_FALLBACK=0

# Future: DEVICE_ADAPTER=shibli_controls
